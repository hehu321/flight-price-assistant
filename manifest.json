{
  "manifest_version": 3,
  "name": "机票比价助手",
  "version": "0.1.0",
  "description": "对比携程、去哪儿、飞猪和同程的机票公开价格及价格趋势分析。",
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "sidePanel",
    "webNavigation",
    "nativeMessaging",
    "alarms",
    "idle",
    "notifications"
  ],
  "host_permissions": [
    "https://*.ctrip.com/*",
    "https://*.qunar.com/*",
    "https://*.fliggy.com/*",
    "https://*.ly.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.ctrip.com/*",
        "https://*.qunar.com/*",
        "https://*.fliggy.com/*",
        "https://*.ly.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "打开机票比价助手"
  },
  "icons": {
    "16": "public/icon.png",
    "48": "public/icon.png",
    "128": "public/icon.png"
  }
}
